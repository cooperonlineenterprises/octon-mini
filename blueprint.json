{
  "schema_version": "project-blueprint.v3",
  "blueprint_version_source": "VERSION",
  "minimum_python": "3.11",
  "modules": {
    "dossier": {
      "definition": "dossier/BLUEPRINT.md",
      "artifact_type_source": "dossier/artifact-types.json",
      "reference_evidence": "dossier/references/REFERENCE_EVIDENCE.md",
      "generated_root": "project-dossier"
    },
    "harness": {
      "definition": "harness/BLUEPRINT.md",
      "reference_evidence": "harness/references/REFERENCE_EVIDENCE.md",
      "generated_roots": [
        "AGENTS.md",
        ".agent",
        ".agents",
        "pb"
      ],
      "kernel_version": "4.0.0",
      "command_manifest": "shared/source-contracts/commands.json",
      "scm_trigger_file": ".agent/scm.json",
      "package_registry_file": ".agent/packages.json",
      "collaboration_workflow_package": "small-team-git-portfolio",
