{
  "schema_version": "project-blueprint.v1",
  "blueprint_version_source": "VERSION",
  "minimum_python": "3.11",
  "modules": {
    "dossier": {
      "definition": "dossier/BLUEPRINT.md",
      "artifact_type_source": "dossier/artifact-types.json",
      "reference_evidence": "dossier/references/REFERENCE_EVIDENCE.md",
      "generated_root": "project-dossier"
    },
    "harness": {
      "definition": "harness/BLUEPRINT.md",
      "reference_evidence": "harness/references/REFERENCE_EVIDENCE.md",
      "generated_roots": [
        "AGENTS.md",
        ".agent",
        ".agents"
      ],
      "kernel_version": "3.0.0",
      "kernel_files": [
        ".agent/policy.json",
        ".agent/context.json",
        ".agent/schema.json",
        ".agent/lifecycle.json",
        ".agent/tools.json",
        ".agent/validators.json",
        ".agent/project.json"
      ],
      "collaboration_workflow_file": ".agent/workflows/small-team-git.json",
      "supported_base_workflows": [
        "solo_direct",
        "solo_hybrid",
        "pair_pr",
        "tiny_pr"
      ],
      "maximum_supported_write_capable_humans": 5,
      "extension_api": "harness.extension.v1",
      "canonical_structured_format": "strict_json"
    }
  },
  "shared_schema_root": "shared/schemas",
  "source_governance": {
    "architecture_decisions": "ARCHITECTURE_DECISIONS.md",
    "architectural_pattern_catalog": "patterns/catalog.json",
    "pattern_catalog_generated": false,
    "pattern_catalog_automatic_adoption": false,
    "generation_policy": "shared/source-contracts/generation-policy.json",
    "information_state_semantics": "shared/source-contracts/information-state-semantics.json",
    "architecture_proof_schema": "patterns/architecture-proof/schema.json",
    "architecture_proof_generated": false
  },
  "optional_contracts": {
    "context_pack_manifest": {
      "schema": "shared/optional-schemas/context-pack-manifest.schema.json",
      "minimum_profile": "high-assurance",
      "manifest_generated": false,
      "permission_grant": false
    }
  },
  "skill": "skills/project-bootstrap/SKILL.md",
  "new_project_generator": "skills/project-bootstrap/scripts/scaffold_project.py",
  "existing_project_planner": "skills/project-bootstrap/scripts/plan_adoption.py",
  "profiles": [
    "minimal",
    "standard",
    "high-assurance"
  ],
  "generation_contract": "shared/GENERATION_CONTRACT.md",
  "reference_evidence_registry": "shared/reference-evidence.json",
  "overwrite_existing_paths": false,
  "new_generation_requires_empty_target": true,
  "generated_snapshot_is_independent": true
}
