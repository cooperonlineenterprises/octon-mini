{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-blueprint.local/schemas/artifact-catalog.schema.json",
  "title": "Project Dossier Artifact Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dossier_version",
    "authority",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "project-dossier.artifact-catalog.v1"
    },
    "dossier_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "category",
        "classification",
        "information_state",
        "authority",
        "generated",
        "source_refs",
        "owner_role",
        "last_reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9]{4}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:\\.agent|project-dossier)/[^\\\\]*$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "core",
            "conditional",
            "optional"
          ]
        },
        "information_state": {
          "enum": [
            "navigation",
            "governance",
            "canonical_target",
            "current_state",
            "conformance",
            "planning",
            "register",
            "provenance",
            "evidence",
            "handoff",
            "historical",
            "generated"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "generated": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "review_cadence": {
          "type": [
            "string",
            "null"
          ]
        },
        "update_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sensitivity": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
