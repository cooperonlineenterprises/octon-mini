{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-blueprint.local/schemas/project-blueprint-setup-answers.schema.json",
  "title": "Project Blueprint Guided Setup Answer Batch",
  "description": "A non-authorizing answer batch bound to one exact setup-session digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "permission_grant", "session_digest", "answers", "limitations"],
  "properties": {
    "schema_version": {"const": "project-blueprint.setup-answers.v1"},
    "permission_grant": {"const": false},
    "session_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "state", "value", "supplied_by", "evidence"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "state": {"enum": ["answered", "unknown", "deferred", "not_applicable"]},
          "value": {},
          "supplied_by": {"enum": ["user", "agent", "tty", "cli", "review_artifact"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "observed_at", "expires_at", "confidence", "limitations"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "observed_at": {"type": "string", "format": "date-time"},
              "expires_at": {"type": ["string", "null"], "format": "date-time"},
              "confidence": {"enum": ["low", "medium", "high", "deterministic"]},
              "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
