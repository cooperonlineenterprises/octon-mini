{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/harness-diagnostics-v2.schema.json",
  "title": "Read-Only Octon Mini Continuation Diagnostic Report",
  "description": "A diagnostic projection using the same typed continuation findings emitted by blocked operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "permission_grant", "read_only", "structural_conformance", "findings", "derived_repair", "limitations"],
  "properties": {
    "schema_version": {"const": "harness.diagnostic-report.v2"},
    "permission_grant": {"const": false},
    "read_only": {"const": true},
    "structural_conformance": {"enum": ["pass", "fail", "not_assessed"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "derived_repair": {"type": ["object", "null"]},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "proof_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "reason", "validity_classes"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "validity_classes": {"$ref": "#/$defs/strings"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "argv", "read_only", "requires_confirmation"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "argv": {"$ref": "#/$defs/argv"},
        "read_only": {"type": "boolean"},
        "requires_confirmation": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_kind", "permission_grant", "failure_code", "blocked_operation", "phase", "mutation", "root_cause", "invalidated", "preserved", "authority_source", "repair_class", "next_action", "safe_read_only_actions", "successor", "limitations"],
      "properties": {
        "schema_version": {"const": "octon-mini.continuation.v1"},
        "artifact_kind": {"const": "blocked_operation"},
        "permission_grant": {"const": false},
        "failure_code": {"type": "string", "pattern": "^OCTON-[A-Z]+-[0-9]{4}$"},
        "blocked_operation": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "mutation": {"type": "object"},
        "root_cause": {"type": "string", "minLength": 1},
        "invalidated": {"type": "array", "items": {"$ref": "#/$defs/proof_state"}},
        "preserved": {"type": "array", "items": {"$ref": "#/$defs/proof_state"}},
        "authority_source": {"type": "string", "minLength": 1},
        "repair_class": {"type": "string", "minLength": 1},
        "next_action": {"$ref": "#/$defs/action"},
        "safe_read_only_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "successor": {"type": "object"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
