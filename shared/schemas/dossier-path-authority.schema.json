{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/dossier-path-authority.schema.json",
  "title": "Generated Project Dossier Path Authority",
  "description": "Generated physical-path classification derived from the project-local artifact registry. This file never grants permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_role",
    "permission_grant",
    "project_slug",
    "generation_id",
    "source_registry",
    "paths"
  ],
  "properties": {
    "schema_version": {
      "const": "project.dossier.path-authority.v2"
    },
    "document_role": {
      "const": "generated_from_artifact_registry"
    },
    "permission_grant": {
      "const": false
    },
    "project_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "source_registry": {
      "const": "project-dossier/machine-readable/artifact-registry.json"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "representation_id",
          "artifact_type_ids",
          "information_state",
          "authority",
          "source_direction",
          "generated"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^project-dossier/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "representation_id": {
            "type": "string",
            "pattern": "^REP-[0-9]{4}$"
          },
          "artifact_type_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4}$"
            }
          },
          "information_state": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "source_direction": {
            "type": "string",
            "minLength": 1
          },
          "generated": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
