{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/harness-capability-records.schema.json",
  "title": "Project Harness Capability Records",
  "description": "Closed contracts for non-authorizing agent modes, workflow state machines, and skill provenance. Schema conformance does not adopt, trust, authorize, or approve a capability.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "inherits_from",
        "may_expand"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "inherits_from": {
          "const": "current_task"
        },
        "may_expand": {
          "const": false
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "optional": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "required_fields",
        "evidence_required"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "evidence_required": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_version",
        "source_fingerprint",
        "generated_on",
        "license_review",
        "security_review",
        "included_files",
        "local_changes",
        "exclusions",
        "trust_class",
        "update_strategy"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        },
        "license_review": {
          "enum": [
            "not_assessed",
            "review_required",
            "reviewed",
            "not_applicable"
          ]
        },
        "security_review": {
          "enum": [
            "not_assessed",
            "review_required",
            "reviewed",
            "not_applicable"
          ]
        },
        "included_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        },
        "local_changes": {
          "$ref": "#/$defs/strings"
        },
        "exclusions": {
          "$ref": "#/$defs/strings"
        },
        "trust_class": {
          "enum": [
            "generated_unadopted_capability",
            "project_local_reviewed_capability",
            "imported_reviewed_capability",
            "untrusted_imported_capability"
          ]
        },
        "update_strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requires",
        "actions",
        "agent_ref",
        "gate",
        "on_success",
        "on_failure",
        "on_actionable_findings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "action",
            "review",
            "terminal"
          ]
        },
        "requires": {
          "$ref": "#/$defs/strings"
        },
        "actions": {
          "$ref": "#/$defs/strings"
        },
        "agent_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "gate": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "on_success": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "on_failure": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "on_actionable_findings": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "version",
        "adoption_status",
        "adoption_decision_ref",
        "permission_grant",
        "purpose",
        "scope",
        "authority",
        "side_effects",
        "inputs",
        "outputs",
        "skill_refs",
        "prohibited",
        "validation",
        "owner",
        "provenance",
        "deprecated_at",
        "removal_version",
        "successor",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.agent.v1"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "adoption_status": {
          "enum": [
            "generated_unadopted_baseline",
            "adopted",
            "disabled",
            "deprecated",
            "superseded"
          ]
        },
        "adoption_decision_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^DEC-[0-9]{4}$"
        },
        "permission_grant": {
          "const": false
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "side_effects": {
          "enum": [
            "read_only",
            "repository_local_as_authorized_by_current_task",
            "external_effects_require_explicit_current_authorization"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "skill_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "prohibited": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "deprecated_at": {
          "description": "Harness kernel version in which this capability was first deprecated.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "removal_version": {
          "description": "Harness kernel version at which this capability must no longer remain registered.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "successor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_strings"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "version",
        "adoption_status",
        "adoption_decision_ref",
        "permission_grant",
        "purpose",
        "scope",
        "authority",
        "side_effects",
        "inputs",
        "outputs",
        "prohibited",
        "initial_state",
        "cancellation_state",
        "states",
        "terminal_states",
        "invariants",
        "validation",
        "owner",
        "provenance",
        "deprecated_at",
        "removal_version",
        "successor",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.workflow.v1"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "adoption_status": {
          "enum": [
            "generated_unadopted_baseline",
            "adopted",
            "disabled",
            "deprecated",
            "superseded"
          ]
        },
        "adoption_decision_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^DEC-[0-9]{4}$"
        },
        "permission_grant": {
          "const": false
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "side_effects": {
          "enum": [
            "read_only",
            "repository_local_as_authorized_by_current_task",
            "external_effects_require_explicit_current_authorization"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "prohibited": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "initial_state": {
          "$ref": "#/$defs/slug"
        },
        "cancellation_state": {
          "$ref": "#/$defs/slug"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workflow_state"
          }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "invariants": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "deprecated_at": {
          "description": "Harness kernel version in which this capability was first deprecated.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "removal_version": {
          "description": "Harness kernel version at which this capability must no longer remain registered.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "successor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_strings"
        }
      }
    },
    "skill_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "version",
        "adoption_status",
        "adoption_decision_ref",
        "permission_grant",
        "entrypoint",
        "purpose",
        "scope",
        "authority",
        "side_effects",
        "inputs",
        "outputs",
        "prohibited",
        "validation",
        "owner",
        "included_material",
        "provenance",
        "deprecated_at",
        "removal_version",
        "successor",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "harness.skill-provenance.v1"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "adoption_status": {
          "enum": [
            "generated_unadopted_baseline",
            "adopted",
            "disabled",
            "deprecated",
            "superseded"
          ]
        },
        "adoption_decision_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^DEC-[0-9]{4}$"
        },
        "permission_grant": {
          "const": false
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "side_effects": {
          "enum": [
            "read_only",
            "repository_local_as_authorized_by_current_task",
            "external_effects_require_explicit_current_authorization"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "prohibited": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "included_material": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "deprecated_at": {
          "description": "Harness kernel version in which this capability was first deprecated.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "removal_version": {
          "description": "Harness kernel version at which this capability must no longer remain registered.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "successor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_strings"
        }
      }
    }
  }
}
