{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/octon-mini-bootstrap-setup-session.schema.json",
  "title": "Octon Mini Project Bootstrap Guided Setup Session",
  "description": "A non-authorizing, resumable, fingerprint-bound setup interview consumed by the existing init, adopt, or upgrade planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_version",
    "permission_grant",
    "session_id",
    "sequence",
    "created_at",
    "updated_at",
    "mode",
    "target_identity",
    "target_revision",
    "target_fingerprint",
    "governing_instruction_fingerprint",
    "octon_mini",
    "question_catalog",
    "selected_profile",
    "selected_layout",
    "question_states",
    "inventories",
    "recommendations",
    "user_selections",
    "accepted_authority_references",
    "unresolved_blockers",
    "next_eligible_questions",
    "generated_plan_references",
    "work_completion_assessment",
    "minimum_closure_sequence",
    "session_status",
    "successor_of",
    "limitations",
    "canonical_session_digest"
  ],
  "properties": {
    "schema_version": {"const": "octon-mini.bootstrap.setup-session.v1"},
    "artifact_kind": {"const": "setup_session"},
    "artifact_version": {"const": "1.0.0"},
    "permission_grant": {"const": false},
    "session_id": {"type": "string", "pattern": "^SETUP-[a-f0-9]{24}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["initialization", "adoption", "upgrade"]},
    "target_identity": {"$ref": "#/$defs/target_identity"},
    "target_revision": {"$ref": "#/$defs/target_revision"},
    "target_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "governing_instruction_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "octon_mini": {"$ref": "#/$defs/octon_mini"},
    "question_catalog": {"$ref": "#/$defs/catalog"},
    "selected_profile": {"type": ["string", "null"], "enum": ["minimal", "standard", "high-assurance", null]},
    "selected_layout": {"type": ["string", "null"], "enum": ["compact", "separated", null]},
    "question_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/question_state"}
    },
    "inventories": {"$ref": "#/$defs/inventories"},
    "recommendations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "user_selections": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/selection"}
    },
    "accepted_authority_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authority_reference"}
    },
    "unresolved_blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "next_eligible_questions": {"$ref": "#/$defs/question_ids"},
    "generated_plan_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/plan_reference"}
    },
    "work_completion_assessment": {"$ref": "#/$defs/work_completion"},
    "minimum_closure_sequence": {
      "type": "array",
      "items": {"$ref": "#/$defs/setup_closure_step"}
    },
    "session_status": {"enum": ["collecting", "ready_for_plan", "stale", "superseded"]},
    "successor_of": {"type": ["object", "null"], "additionalProperties": false, "properties": {"session_id": {"type": "string", "pattern": "^SETUP-[a-f0-9]{24}$"}, "canonical_session_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reason": {"type": "string", "minLength": 1}}, "required": ["session_id", "canonical_session_digest", "reason"]},
    "limitations": {"$ref": "#/$defs/strings"},
    "canonical_session_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_path", "canonical_path", "detected_mode", "mode_evidence"],
      "properties": {
        "requested_path": {"type": "string", "minLength": 1},
        "canonical_path": {"type": "string", "minLength": 1},
        "detected_mode": {"enum": ["initialization", "adoption", "upgrade", "ambiguous"]},
        "mode_evidence": {"$ref": "#/$defs/strings"}
      }
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scm", "revision", "dirty_state_observed"],
      "properties": {
        "scm": {"enum": ["git", "none"]},
        "revision": {"type": ["string", "null"]},
        "dirty_state_observed": {"enum": ["clean", "dirty", "unborn", "not_applicable", "unknown"]}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "paths", "digest"],
      "properties": {
        "algorithm": {"const": "sha256_path_type_nul_content_nul_v1"},
        "paths": {"$ref": "#/$defs/strings"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "octon_mini": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_version", "candidate_version", "installed_version", "provenance_status", "installed_packages"],
      "properties": {
        "source_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "candidate_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "installed_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "provenance_status": {"enum": ["absent", "valid", "invalid", "ambiguous"]},
        "installed_packages": {"$ref": "#/$defs/strings"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "catalog_version", "sha256"],
      "properties": {
        "schema_version": {"const": "octon-mini.bootstrap.setup-question-catalog.v1"},
        "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "expires_at", "confidence", "limitations"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "confidence": {"enum": ["low", "medium", "high", "deterministic"]},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "question_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question_version", "state", "information_role", "value", "supplied_by", "evidence"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "question_version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["answered", "unknown", "deferred", "not_applicable"]},
        "information_role": {"enum": ["observation", "inference", "initialization_input", "recommendation", "owner_selection", "accepted_authority_reference"]},
        "value": {},
        "supplied_by": {"enum": ["inspection", "user", "agent", "tty", "cli", "review_artifact"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answered", "unknown", "deferred", "not_applicable"],
      "properties": {
        "answered": {"$ref": "#/$defs/question_ids"},
        "unknown": {"$ref": "#/$defs/question_ids"},
        "deferred": {"$ref": "#/$defs/question_ids"},
        "not_applicable": {"$ref": "#/$defs/question_ids"}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "value", "rationale", "evidence_refs"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "value": {},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "value", "accepted_authority"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "value": {},
        "accepted_authority": {"const": false}
      }
    },
    "authority_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "reference", "setup_validation"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "reference": {"type": "string", "pattern": "^(authority|external):.+$"},
        "setup_validation": {"const": "reference_syntax_valid_project_resolution_required"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "consequence", "required_action"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "consequence": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1}
      }
    },
    "plan_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "canonical_plan_digest", "path", "created_at"],
      "properties": {
        "operation": {"enum": ["init.project", "adopt.install", "upgrade.project"]},
        "canonical_plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "path": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "closure_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "kind", "description", "can_run_in_parallel", "blocks_enablement"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["decision", "package", "configuration", "evidence", "specialist_review", "validation"]},
        "description": {"type": "string", "minLength": 1},
        "can_run_in_parallel": {"type": "boolean"},
        "blocks_enablement": {"type": "boolean"}
      }
    },
    "setup_closure_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "question_id", "kind", "description", "can_run_in_parallel", "blocks_plan", "blocks_adoption_or_feature"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "question_id": {"type": ["string", "null"], "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "kind": {"enum": ["decision", "approval", "package", "configuration", "evidence", "specialist_review", "validation"]},
        "description": {"type": "string", "minLength": 1},
        "can_run_in_parallel": {"type": "boolean"},
        "blocks_plan": {"type": "boolean"},
        "blocks_adoption_or_feature": {"type": "boolean"}
      }
    },
    "work_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_mode", "status", "missing_prerequisites", "closure_sequence", "external_action_authorization"],
      "properties": {
        "selected_mode": {"type": ["string", "null"], "enum": ["disabled", "on_demand", "on_demand_plus_plan_only_event", null]},
        "status": {"enum": ["unanswered", "deferred", "disabled", "pending_prerequisites", "eligible_for_separate_configuration"]},
        "missing_prerequisites": {"$ref": "#/$defs/strings"},
        "closure_sequence": {"type": "array", "items": {"$ref": "#/$defs/closure_step"}},
        "external_action_authorization": {"const": false}
      }
    }
  }
}
