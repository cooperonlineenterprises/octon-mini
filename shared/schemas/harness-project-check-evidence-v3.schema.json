{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/harness-project-check-evidence-v3.schema.json",
  "title": "Project Check Evidence Store with Validation Proof Reuse",
  "description": "A bounded evidence store whose content-addressed proofs are written and reused only by the explicit project-check writer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_role", "permission_grant", "archive_root", "current_record_limit", "records", "proofs", "successor_relationships"],
  "properties": {
    "schema_version": {"const": "harness.project-check-evidence-store.v3"},
    "document_role": {"const": "bounded_current_index_and_content_addressed_proofs_of_project_owned_execution_evidence"},
    "permission_grant": {"const": false},
    "archive_root": {"const": ".agent/project-checks/archive"},
    "current_record_limit": {"const": 25},
    "records": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_record"}},
    "proofs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/proof"}},
    "successor_relationships": {"type": "array", "uniqueItems": true, "items": {"type": "object"}}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "proof_id", "permission_grant", "reusable", "input_set", "input_digest", "check_identity", "argv", "executable", "configuration_digest", "governing_instruction_digest", "environment", "side_effects", "freshness_days", "observed_at", "fresh_until", "result", "limitations", "canonical_proof_digest"],
      "properties": {
        "schema_version": {"const": "harness.validation-proof.v1"},
        "proof_id": {"type": "string", "pattern": "^VPR-[a-f0-9]{32}$"},
        "permission_grant": {"const": false},
        "reusable": {"type": "boolean"},
        "input_set": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
        "input_digest": {"$ref": "#/$defs/digest"},
        "check_identity": {"type": "string", "minLength": 1},
        "argv": {"$ref": "#/$defs/argv"},
        "executable": {"type": "object"},
        "configuration_digest": {"$ref": "#/$defs/digest"},
        "governing_instruction_digest": {"$ref": "#/$defs/digest"},
        "environment": {"type": "object"},
        "side_effects": {"type": "object"},
        "freshness_days": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "fresh_until": {"type": "string", "format": "date-time"},
        "result": {"const": "pass"},
        "limitations": {"$ref": "#/$defs/strings"},
        "canonical_proof_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["hook", "outcome"],
      "properties": {
        "hook": {"enum": ["project_test", "project_lint", "project_build", "project_closure"]},
        "outcome": {"enum": ["pass", "fail", "unavailable", "not_applicable", "not_assessed"]},
        "execution": {"enum": ["executed", "reused"]},
        "proof_id": {"type": ["string", "null"], "pattern": "^VPR-[a-f0-9]{32}$"}
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "id", "permission_grant", "readiness_claim", "checks", "overall_outcome", "limitations"],
      "properties": {
        "schema_version": {"enum": ["harness.project-check-evidence.v1", "harness.project-check-evidence.v2"]},
        "id": {"type": "string", "pattern": "^PCE-[a-f0-9]{32}$"},
        "permission_grant": {"const": false},
        "readiness_claim": {"const": false},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "reused_proof_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^VPR-[a-f0-9]{32}$"}},
        "overall_outcome": {"enum": ["pass", "fail", "unavailable"]},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
