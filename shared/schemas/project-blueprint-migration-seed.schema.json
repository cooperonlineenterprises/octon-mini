{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-blueprint.local/schemas/project-blueprint-migration-seed.schema.json",
  "title": "Project Blueprint 3.1.0 to 4.0.0 Reviewed Migration Seed",
  "$defs": {
    "inventory_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "upgrade_policy", "baseline_confirmation", "mode", "sha256", "rationale"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["blueprint_implementation_asset", "project_owned_authoritative", "review_required_governance", "derived", "provenance"]},
        "upgrade_policy": {"enum": ["exact_pristine_or_additive", "always_review", "regenerate", "provenance_transaction_only"]},
        "baseline_confirmation": {"enum": ["exact_pristine", "project_modified", "derived", "provenance"]},
        "mode": {"type": ["integer", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "permission_grant", "reviewed_at", "origin_sha256", "project_sha256", "layout", "authority_source", "evidence_refs", "paths", "limitations"],
      "properties": {
        "schema_version": {"const": "project-blueprint.migration-review.3.1.0-to-4.0.0.v1"},
        "permission_grant": {"const": false},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "origin_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "layout": {"const": "separated"},
        "authority_source": {"type": "string", "pattern": "^(?:authority|external):.+$"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inventory_path"}},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_kind", "permission_grant", "target", "created_at", "source_origin_state", "source_project_state", "authority_source", "evidence_refs", "origin_seed", "limitations", "canonical_seed_digest"],
      "properties": {
        "schema_version": {"const": "project-blueprint.migration-seed.3.1.0-to-4.0.0.v1"},
        "artifact_kind": {"const": "reviewed_legacy_inventory_seed"},
        "permission_grant": {"const": false},
        "target": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "source_origin_state": {"type": "object"},
        "source_project_state": {"type": "object"},
        "authority_source": {"type": "string", "pattern": "^(?:authority|external):.+$"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{4}$"}},
        "origin_seed": {"type": "object"},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_seed_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
