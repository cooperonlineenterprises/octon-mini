{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/harness-extension-registry.schema.json",
  "title": "Project Harness Extension Registry",
  "description": "Strict registry contract for restrictions-only project extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_version",
    "extension_api",
    "permission_grant",
    "execution_boundary",
    "extensions"
  ],
  "properties": {
    "schema_version": {"const": "harness.extension-registry.v1"},
    "core_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "extension_api": {"const": "harness.extension.v1"},
    "permission_grant": {"const": false},
    "execution_boundary": {
      "const": "trusted_project_local_code_with_least_environment_and_post_execution_write_detection; external sandbox required for strong isolation"
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enabled",
          "version",
          "path",
          "requires_core",
          "config",
          "validator",
          "owner",
          "provenance",
          "trust_class",
          "trust_decision_ref",
          "side_effects",
          "network_access",
          "filesystem_writes",
          "authority_effect",
          "deprecated_at",
          "removal_version",
          "successor"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "enabled": {"type": "boolean"},
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "path": {
            "type": "string",
            "pattern": "^\\.agent/extensions/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "requires_core": {
            "type": "string",
            "pattern": "^\\^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "config": {
            "type": "string",
            "pattern": "^\\.agent/extensions/[a-z0-9]+(?:-[a-z0-9]+)*/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+\\.json$"
          },
          "validator": {
            "type": "string",
            "pattern": "^\\.agent/extensions/[a-z0-9]+(?:-[a-z0-9]+)*/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+\\.py$"
          },
          "owner": {"type": "string", "minLength": 1},
          "provenance": {"type": "string", "minLength": 1},
          "trust_class": {
            "enum": [
              "unassessed_project_local_code",
              "trusted_project_local_code"
            ]
          },
          "trust_decision_ref": {
            "type": ["string", "null"],
            "pattern": "^DEC-[0-9]{4}$"
          },
          "side_effects": {
            "enum": [
              "none",
              "read_only",
              "repository_local_restriction_checks"
            ]
          },
          "network_access": {"const": "denied"},
          "filesystem_writes": {"const": "prohibited"},
          "authority_effect": {"const": "restrictions_only"},
          "deprecated_at": {
            "type": ["string", "null"],
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "removal_version": {
            "type": ["string", "null"],
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "successor": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
  ,
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4}$"
        }
      }
    }
  }
}
