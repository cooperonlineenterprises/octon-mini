{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octon-mini.local/schemas/octon-mini-bootstrap-setup-session-v2.schema.json",
  "title": "Octon Mini Dependency-Scoped Guided Setup Session",
  "description": "An immutable, non-authorizing setup-session successor with explicit validity bindings and reinspection classifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "artifact_version",
    "permission_grant",
    "session_id",
    "sequence",
    "created_at",
    "updated_at",
    "mode",
    "target_identity",
    "target_revision",
    "target_fingerprint",
    "governing_instruction_fingerprint",
    "octon_mini",
    "question_catalog",
    "validity_policy_version",
    "question_states",
    "reinspection",
    "inventories",
    "recommendations",
    "user_selections",
    "accepted_authority_references",
    "reused_decisions",
    "unresolved_blockers",
    "next_eligible_questions",
    "generated_plan_references",
    "work_completion_assessment",
    "minimum_closure_sequence",
    "selected_profile",
    "selected_layout",
    "session_status",
    "successor_of",
    "limitations",
    "canonical_session_digest"
  ],
  "properties": {
    "schema_version": {"const": "octon-mini.bootstrap.setup-session.v2"},
    "artifact_kind": {"const": "setup_session"},
    "artifact_version": {"const": "2.0.0"},
    "permission_grant": {"const": false},
    "session_id": {"type": "string", "pattern": "^SETUP-[a-f0-9]{24}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["initialization", "adoption", "upgrade"]},
    "target_identity": {"$ref": "#/$defs/target_identity"},
    "target_revision": {"$ref": "#/$defs/target_revision"},
    "target_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "governing_instruction_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "octon_mini": {"type": "object"},
    "question_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "catalog_version", "sha256"],
      "properties": {
        "schema_version": {"const": "octon-mini.bootstrap.setup-question-catalog.v2"},
        "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "validity_policy_version": {"const": "octon-mini.setup-validity.v1"},
    "question_states": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/question_state"}},
    "reinspection": {"$ref": "#/$defs/reinspection"},
    "inventories": {"$ref": "#/$defs/inventories"},
    "recommendations": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "user_selections": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "accepted_authority_references": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "reused_decisions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reused_decision"}},
    "unresolved_blockers": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "next_eligible_questions": {"$ref": "#/$defs/question_ids"},
    "generated_plan_references": {"type": "array", "uniqueItems": true, "items": {"type": "object"}},
    "work_completion_assessment": {"type": "object"},
    "minimum_closure_sequence": {"type": "array", "items": {"type": "object"}},
    "selected_profile": {"type": ["string", "null"], "enum": ["minimal", "standard", "high-assurance", null]},
    "selected_layout": {"type": ["string", "null"], "enum": ["compact", "separated", null]},
    "session_status": {"enum": ["collecting", "ready_for_plan", "stale", "superseded"]},
    "successor_of": {"type": ["object", "null"]},
    "limitations": {"$ref": "#/$defs/strings"},
    "canonical_session_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
    "validity_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["re_observe_every_run", "source_fingerprint_bound", "dependency_bound", "expiry_bound", "decision_successor_or_revocation_bound", "runtime_only_never_reusable"]}
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_path", "canonical_path", "detected_mode", "mode_evidence"],
      "properties": {
        "requested_path": {"type": "string", "minLength": 1},
        "canonical_path": {"type": "string", "minLength": 1},
        "detected_mode": {"enum": ["initialization", "adoption", "upgrade", "ambiguous"]},
        "mode_evidence": {"$ref": "#/$defs/strings"}
      }
    },
    "target_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scm", "revision", "dirty_state_observed"],
      "properties": {
        "scm": {"enum": ["git", "none"]},
        "revision": {"type": ["string", "null"]},
        "dirty_state_observed": {"enum": ["clean", "dirty", "unborn", "not_applicable", "unknown"]}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "paths", "digest"],
      "properties": {
        "algorithm": {"const": "sha256_path_type_nul_content_nul_v1"},
        "paths": {"$ref": "#/$defs/strings"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observed_at", "expires_at", "confidence", "limitations"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "confidence": {"enum": ["low", "medium", "high", "deterministic"]},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "subject_type", "digest", "expires_at"],
      "properties": {
        "kind": {"enum": ["catalog_question", "question_dependencies", "governing_instructions", "target_mode", "octon_mini_provenance", "project_configuration", "decision_record", "evidence_source"]},
        "reference": {"type": "string", "minLength": 1},
        "subject_type": {"enum": ["metadata", "file", "absent"]},
        "digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "bindings", "reuse_status", "reason"],
      "properties": {
        "classes": {"$ref": "#/$defs/validity_classes"},
        "bindings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
        "reuse_status": {"enum": ["current", "preserved", "reobserved", "needs_confirmation", "invalidated", "newly_introduced"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "question_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question_version", "state", "information_role", "value", "supplied_by", "evidence", "validity"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "question_version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["answered", "unknown", "deferred", "not_applicable"]},
        "information_role": {"enum": ["observation", "inference", "initialization_input", "recommendation", "owner_selection", "accepted_authority_reference"]},
        "value": {},
        "supplied_by": {"enum": ["inspection", "user", "agent", "tty", "cli", "review_artifact", "accepted_decision"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "validity": {"$ref": "#/$defs/validity"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "reason"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^setup\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "reinspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "reobserved", "needs_confirmation", "invalidated", "newly_introduced"],
      "properties": {
        "preserved": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
        "reobserved": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
        "needs_confirmation": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
        "invalidated": {"type": "array", "items": {"$ref": "#/$defs/classification"}},
        "newly_introduced": {"type": "array", "items": {"$ref": "#/$defs/classification"}}
      }
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answered", "unknown", "deferred", "not_applicable", "needs_confirmation", "invalidated"],
      "properties": {
        "answered": {"$ref": "#/$defs/question_ids"},
        "unknown": {"$ref": "#/$defs/question_ids"},
        "deferred": {"$ref": "#/$defs/question_ids"},
        "not_applicable": {"$ref": "#/$defs/question_ids"},
        "needs_confirmation": {"$ref": "#/$defs/question_ids"},
        "invalidated": {"$ref": "#/$defs/question_ids"}
      }
    },
    "reused_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reuse_policy_id", "decision_ref", "question_ids", "valid_until", "limitations"],
      "properties": {
        "reuse_policy_id": {"type": "string", "pattern": "^DRP-[0-9]{4}$"},
        "decision_ref": {"type": "string", "pattern": "^DEC-[0-9]{4}$"},
        "question_ids": {"$ref": "#/$defs/question_ids"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "limitations": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
