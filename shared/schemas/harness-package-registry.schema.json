{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-blueprint.local/schemas/harness-package-registry.schema.json",
  "title": "Triggered Package Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_role", "permission_grant", "packages", "requirements", "limitations"],
  "properties": {
    "schema_version": {"const": "harness.package-registry.v1"},
    "document_role": {"const": "project_owned_triggered_package_registry"},
    "permission_grant": {"const": false},
    "packages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "sha256", "installed_paths", "installed_paths_sha256", "owner", "trust_decision_ref", "validation_status", "validation_receipt_ref", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["scm_portfolio", "domain_extension", "reference_extension", "optional_schema"]},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "installed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "installed_paths_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "owner": {"type": "string", "minLength": 1},
          "trust_decision_ref": {"type": "string", "pattern": "^(?:DEC-[0-9]{4}|(?:authority|external):.+)$"},
          "validation_status": {"const": "pass"},
          "validation_receipt_ref": {"type": "string", "pattern": "^RCPT-[a-f0-9]{24}$"},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable_package_requires_owner", "applicable_package_requires_accepted_trust_decision", "installed_version_and_digest_required", "successful_validation_required", "current_evidence_required_when_declared", "absence_means_not_applicable"],
      "properties": {
        "applicable_package_requires_owner": {"const": true},
        "applicable_package_requires_accepted_trust_decision": {"const": true},
        "installed_version_and_digest_required": {"const": true},
        "successful_validation_required": {"const": true},
        "current_evidence_required_when_declared": {"const": true},
        "absence_means_not_applicable": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
