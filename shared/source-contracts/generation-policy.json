  "forbidden_outputs": [
    {
      "path": "patterns",
      "match": "subtree",
      "reason": "The source Pattern Catalog is not a generated-project namespace."
    },
    {
      "path": "ARCHITECTURE_DECISIONS.md",
      "match": "exact",
      "reason": "Source decisions must not be copied as project decisions."
    },
    {
      "path": "ARCHITECTURAL_PATTERN_INTEGRATION_REVIEW.md",
      "match": "exact",
      "reason": "The source review and deferred-trigger watchlist are not project defaults."
    },
    {
      "path": "migrations",
      "match": "subtree",
      "reason": "Source migration guidance is consulted deliberately, not generated into projects."
    },
    {
      "path": "shared/source-contracts",
      "match": "subtree",
      "reason": "Blueprint source-governance contracts are not project runtime files."
    },
    {
      "path": ".agent/schemas/architecture-proof.schema.json",
      "match": "exact",
      "reason": "Architecture Proof remains a source-only optional family."
    },
    {
      "path": ".agent/templates/architecture-proof",
      "match": "subtree",
      "reason": "Architecture Proof templates are not generated by any profile."
    }
  ],
  "limitations": [
    "This policy governs automatic target-project generation, not the installed skill source bundle.",
    "A project may deliberately adopt a source-only artifact through its own authority and migration process.",
    "Runtime generation ignores unreviewed additions; repository validation remains strict and requires explicit review.",
    "Inventory hashes bind reviewed source paths, not substantive correctness or project readiness."
  ]
