{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-blueprint.local/source-contracts/commands.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_role", "permission_grant", "commands", "advanced_primitives", "limitations"],
  "properties": {
    "schema_version": {"const": "harness.command-manifest.v1"},
    "document_role": {"const": "authoritative_workflow_interface_inventory_and_projection_source"},
    "permission_grant": {"const": false},
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "availability", "read_only", "mutation_model", "authorization_gate"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*$"},
          "availability": {"enum": ["bootstrap_source", "generated_project"]},
          "read_only": {"type": "boolean"},
          "mutation_model": {"type": "string", "minLength": 1},
          "authorization_gate": {"type": "string", "minLength": 1}
        }
      }
    },
    "advanced_primitives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
