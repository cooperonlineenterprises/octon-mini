{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-blueprint.local/source-schemas/architecture-proof.schema.json",
  "title": "Project Blueprint Optional Architecture Proof",
  "description": "Source-only optional proof contract. Completion does not grant permission or establish production readiness.",
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "expected_behavior",
        "result",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CASE-[0-9]{4}$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "not_run",
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/strings"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "proof_kind",
    "status",
    "permission_grant",
    "production_readiness_inference",
    "title",
    "hypothesis",
    "subject",
    "environment",
    "acceptance_criteria",
    "stop_criteria",
    "adversarial_cases",
    "method",
    "evidence_refs",
    "failures",
    "skipped_checks",
    "cleanup_or_rollback",
    "limitations",
    "conclusion",
    "non_proven_implications",
    "decision_refs",
    "owner",
    "created_on",
    "completed_on"
  ],
  "properties": {
    "schema_version": {
      "const": "project-blueprint.architecture-proof.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^PROOF-[0-9]{4}$"
    },
    "proof_kind": {
      "enum": [
        "spike",
        "reference_slice",
        "provider_qualification",
        "adversarial_fixture_pack",
        "readiness_evidence"
      ]
    },
    "status": {
      "enum": [
        "template",
        "planned",
        "in_progress",
        "completed",
        "abandoned"
      ]
    },
    "permission_grant": {
      "const": false
    },
    "production_readiness_inference": {
      "const": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "version_or_revision",
        "configuration"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "version_or_revision": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "source_revision",
        "toolchain_versions"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "toolchain_versions": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "acceptance_criteria": {
      "$ref": "#/$defs/strings"
    },
    "stop_criteria": {
      "$ref": "#/$defs/strings"
    },
    "adversarial_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "method": {
      "$ref": "#/$defs/strings"
    },
    "evidence_refs": {
      "$ref": "#/$defs/strings"
    },
    "failures": {
      "$ref": "#/$defs/strings"
    },
    "skipped_checks": {
      "$ref": "#/$defs/strings"
    },
    "cleanup_or_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "status",
        "evidence_refs",
        "residual_effects"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_assessed",
            "not_required",
            "planned",
            "completed",
            "failed"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/strings"
        },
        "residual_effects": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "limitations": {
      "$ref": "#/$defs/strings"
    },
    "conclusion": {
      "enum": [
        "not_assessed",
        "supported",
        "unsupported",
        "inconclusive"
      ]
    },
    "non_proven_implications": {
      "$ref": "#/$defs/strings"
    },
    "decision_refs": {
      "$ref": "#/$defs/strings"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "completed_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
