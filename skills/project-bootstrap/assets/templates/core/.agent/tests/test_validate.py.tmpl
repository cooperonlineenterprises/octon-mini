def adopt_harness(
    test_root: Path,
    *,
    commands: dict[str, dict[str, object]] | None = None,
) -> None:
    decision = VALIDATOR.parse_json_header(
        test_root / ".agent/templates/decision.md"
    )
    decision.update(
        id="DEC-9097",
        status="accepted",
        previous_status="proposed",
        title="Adopt the synthetic project harness",
        authority_source="authority:synthetic-adoption-test",
        owner="test_suite",
        scope="synthetic project-harness adoption",
    )
    decision_path = test_root / ".agent/decisions/DEC-9097-adopt-harness.md"
    decision_path.write_text(
        "---\n"
        + json.dumps(decision, indent=2, sort_keys=True)
        + "\n---\n\n# Synthetic adoption\n",
        encoding="utf-8",
    )

    project_path = test_root / ".agent/project.json"
    project = VALIDATOR.load_json(project_path)
    project["project"]["adoption_status"] = "adopted"
    project["project"]["adoption_decision_ref"] = "DEC-9097"
    if commands is not None:
        project["commands"] = commands
    write_json(project_path, project)

    policy_path = test_root / ".agent/policy.json"
    policy = VALIDATOR.load_json(policy_path)
    policy["policy_status"] = "adopted"
    policy["project_specific_adoption"]["status"] = "adopted"
    write_json(policy_path, policy)

    context_path = test_root / ".agent/context.json"
    context = VALIDATOR.load_json(context_path)
    context["context_status"] = "adopted"
    write_json(context_path, context)

    current_path = test_root / ".agent/state/current.json"
    current = VALIDATOR.load_json(current_path)
    current["adoption_status"] = "adopted"
    current["accepted_decisions"] = ["DEC-9097"]
    current["blocked_by"] = []
    write_json(current_path, current)


def assess_high_assurance_triggers_not_applicable(test_root: Path) -> None:
    registry_path = (
        test_root / "project-dossier/machine-readable/artifact-registry.json"
    )
    registry = VALIDATOR.load_json(registry_path)
    for artifact_type in registry["artifact_types"]:
        if artifact_type["classification"] not in {"conditional", "optional"}:
            continue
        artifact_type["applicability"] = {
            "status": "not_applicable",
            "rationale": "Synthetic assessment found no project trigger.",
            "assessed_on": "2030-01-02",
            "assessed_by": "test_suite",
            "evidence_refs": [],
        }
    write_json(registry_path, registry)


