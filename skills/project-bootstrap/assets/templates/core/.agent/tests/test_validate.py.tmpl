def write_task(path: Path, value: dict[str, object]) -> None:
    complete = task_value(value)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "---\n"
        + json.dumps(complete, indent=2, sort_keys=True)
        + "\n---\n\n# Mutation fixture\n",
        encoding="utf-8",
    )


