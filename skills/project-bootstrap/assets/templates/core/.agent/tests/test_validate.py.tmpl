    def test_explicit_writer_never_fabricates_pass_or_conflates_unavailable(self) -> None:
        temporary, test_root = clone()
        try:
            project_path = test_root / ".agent/project.json"
            project = VALIDATOR.load_json(project_path)
            project["commands"] = {
                hook: not_applicable_command()
                for hook in VALIDATOR.PROJECT_COMMAND_HOOKS
            }
            project["commands"]["project_test"] = configured_python_command(
                [sys.executable, "-c", "raise SystemExit(7)"]
            )
            write_json(project_path, project)
            failed = subprocess.run(
                [
                    sys.executable,
                    "-I",
                    "-B",
                    ".agent/scripts/run_project_checks.py",
                    "--write-evidence",
                ],
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertNotEqual(failed.returncode, 0)
            evidence_path = test_root / ".agent/project-checks/evidence.json"
            evidence = VALIDATOR.load_json(evidence_path)
            failed_record = evidence["records"][-1]
            failed_check = next(
                item for item in failed_record["checks"]
                if item["hook"] == "project_test"
            )
            self.assertEqual(failed_check["outcome"], "fail")
            self.assertEqual(failed_check["exit_code"], 7)
            self.assertEqual(failed_record["overall_outcome"], "fail")

            project = VALIDATOR.load_json(project_path)
            unavailable = configured_python_command()
            unavailable["argv"] = ["synthetic-command-that-does-not-exist"]
            unavailable["version_argv"] = [
                "synthetic-command-that-does-not-exist",
                "--version",
            ]
            project["commands"]["project_test"] = unavailable
            write_json(project_path, project)
            missing = subprocess.run(
                [
                    sys.executable,
                    "-I",
                    "-B",
                    ".agent/scripts/run_project_checks.py",
                    "--write-evidence",
                ],
                cwd=test_root,
                capture_output=True,
                text=True,
                check=False,
            )
            self.assertNotEqual(missing.returncode, 0)
            evidence = VALIDATOR.load_json(evidence_path)
            unavailable_record = evidence["records"][-1]
            unavailable_check = next(
                item for item in unavailable_record["checks"]
                if item["hook"] == "project_test"
            )
            self.assertEqual(unavailable_check["outcome"], "unavailable")
            self.assertIsNone(unavailable_check["exit_code"])
            self.assertEqual(unavailable_record["overall_outcome"], "unavailable")
            self.assertEqual(
                VALIDATOR.check_project_check_evidence(test_root),
                [],
            )
        finally:
            temporary.cleanup()

