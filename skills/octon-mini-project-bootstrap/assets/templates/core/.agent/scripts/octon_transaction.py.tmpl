#!/usr/bin/env python3
"""Content-addressed, staged, repository-local transactions with recovery."""

from __future__ import annotations

import base64
import hashlib
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import tempfile
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath
from typing import Any, Callable


ROOT = Path(__file__).resolve().parents[2]
PLAN_SCHEMA = "harness.transaction-plan.v2"
RECEIPT_SCHEMA = "harness.transaction-receipt.v2"
PENDING_SCHEMA = "harness.transaction-pending.v1"
RECOVERY_SCHEMA = "harness.transaction-recovery.v1"
ValidatePreview = Callable[[dict[str, bytes | None]], list[str]]


class TransactionError(ValueError):
    """Raised when a plan is ambiguous, stale, unsafe, or invalid."""


def utc_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def canonical_bytes(value: object) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def sha256(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def plan_digest(plan: dict[str, Any]) -> str:
    unsigned = dict(plan)
    unsigned.pop("canonical_plan_digest", None)
    return sha256(canonical_bytes(unsigned))


def new_receipt_id() -> str:
    """Allocate an opaque receipt identity at plan time for evidence linking."""
    return "RCPT-" + secrets.token_hex(12)


def confined_path(root: Path, value: str) -> Path:
    if not value or "\\" in value or "\x00" in value:
        raise TransactionError(f"unsafe transaction path: {value!r}")
    relative = PurePosixPath(value)
    if relative.is_absolute() or any(part in {"", ".", ".."} for part in relative.parts):
        raise TransactionError(f"unsafe transaction path: {value!r}")
    target = root.joinpath(*relative.parts)
    try:
        target.parent.resolve(strict=False).relative_to(root.resolve())
    except (OSError, ValueError) as error:
        raise TransactionError(f"transaction path escapes project: {value!r}") from error
    return target


def existing_transaction_artifact(root: Path, path: Path, directory: str) -> Path:
    root = root.resolve()
    expected_parent = confined_path(
        root, f".agent/transactions/{directory}/placeholder.json"
    ).parent.resolve()
    candidate = path if path.is_absolute() else root / path
    try:
        parent = candidate.parent.resolve(strict=True)
    except OSError as error:
        raise TransactionError(f"transaction artifact directory is unavailable: {path}") from error
    if (
        parent != expected_parent
        or candidate.is_symlink()
        or not candidate.is_file()
        or re.fullmatch(r"RCPT-[a-f0-9]{24}\.json", candidate.name) is None
    ):
        raise TransactionError(
            f"transaction artifact must be a regular receipt-named file in {directory}: {path}"
        )
    return candidate


def path_state(root: Path, relative: str) -> dict[str, Any]:
    target = confined_path(root, relative)
    try:
        metadata = target.lstat()
    except FileNotFoundError:
        return {"path": relative, "type": "absent", "mode": None, "sha256": None}
    mode = stat.S_IMODE(metadata.st_mode)
    if stat.S_ISLNK(metadata.st_mode):
        kind = "symlink"
        identity = os.readlink(target).encode("utf-8", errors="surrogateescape")
    elif stat.S_ISREG(metadata.st_mode):
        kind = "file"
        identity = target.read_bytes()
    elif stat.S_ISDIR(metadata.st_mode):
        kind = "directory"
        identity = b""
    else:
        kind = "other"
        identity = b""
    return {
        "path": relative,
        "type": kind,
        "mode": mode,
        "sha256": sha256(identity),
    }


def instruction_fingerprint(root: Path) -> dict[str, Any]:
    candidates = sorted(
        path for path in root.rglob("AGENTS.md") if path.is_file() and not path.is_symlink()
    )
    digest = hashlib.sha256()
    paths: list[str] = []
    for path in candidates:
        relative = path.relative_to(root).as_posix()
        paths.append(relative)
        digest.update(relative.encode("utf-8"))
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return {
        "algorithm": "sha256_path_nul_content_nul_v1",
        "paths": paths,
        "digest": digest.hexdigest(),
    }


def source_evidence(
    kind: str,
    reference: str,
    *,
    content: bytes | None = None,
    limitations: list[str] | None = None,
) -> dict[str, Any]:
    return {
        "kind": kind,
        "reference": reference,
        "observed_at": utc_timestamp(),
        "sha256": sha256(content) if content is not None else None,
        "limitations": limitations or [],
    }


def operation(
    action: str,
    path: str,
    content: bytes | None,
    rationale: str,
    *,
    mode: int | None = 0o644,
) -> dict[str, Any]:
    if action not in {"create", "replace", "delete"}:
        raise TransactionError(f"unsupported transaction action: {action}")
    if action == "delete":
        content = None
        mode = None
    return {
        "action": action,
        "path": path,
        "content_base64": base64.b64encode(content).decode("ascii") if content is not None else None,
        "mode": mode,
        "rationale": rationale,
    }


def empty_analysis() -> dict[str, list[dict[str, Any]]]:
    return {
        "observations": [],
        "inferences": [],
        "explicit_decisions": [],
        "authorization_gates": [],
    }


def build_plan(
    root: Path,
    *,
    operation_name: str,
    scope: str,
    operations: list[dict[str, Any]],
    evidence: list[dict[str, Any]],
    assumptions: list[str],
    confidence: str,
    limitations: list[str],
    conflicts: list[str] | None = None,
    excluded_paths: list[str] | None = None,
    validation_plan: list[list[str]] | None = None,
    staged_validation_plan: list[list[str]] | None = None,
    post_apply_validation_plan: list[list[str]] | None = None,
    derived_write_paths: list[str] | None = None,
    evidence_paths: list[str] | None = None,
    analysis: dict[str, list[dict[str, Any]]] | None = None,
    planned_receipt_id: str | None = None,
) -> dict[str, Any]:
    if not operations:
        raise TransactionError("a transaction plan requires at least one operation")
    operation_paths = [str(item.get("path")) for item in operations]
    if len(operation_paths) != len(set(operation_paths)):
        raise TransactionError("a transaction plan may operate on each path only once")
    derived_paths = list(dict.fromkeys(derived_write_paths or []))
    if set(operation_paths) & set(derived_paths):
        raise TransactionError("static operations and derived writers may not share a path")
    all_paths = operation_paths + derived_paths
    targets = [path_state(root, path) for path in all_paths]
    for relative, before in zip(all_paths, targets, strict=True):
        if before["type"] in {"symlink", "directory", "other"}:
            raise TransactionError(
                f"transaction target requires specialist review: {relative} ({before['type']})"
            )
    target_by_path = {item["path"]: item for item in targets}
    for item in operations:
        before = target_by_path[item["path"]]
        if item["action"] == "create" and before["type"] != "absent":
            raise TransactionError(f"create target already exists: {before['path']}")
        if item["action"] in {"replace", "delete"} and before["type"] != "file":
            raise TransactionError(f"{item['action']} target is not a regular file: {before['path']}")

    legacy_validation = validation_plan or [
        ["python", "-B", ".agent/scripts/validate.py", "--check"]
    ]
    staged_argv = staged_validation_plan or legacy_validation
    post_argv = post_apply_validation_plan or legacy_validation
    proposal_analysis = analysis or empty_analysis()
    if set(proposal_analysis) != set(empty_analysis()) or any(
        not isinstance(proposal_analysis[key], list) for key in empty_analysis()
    ):
        raise TransactionError("transaction analysis must use the closed observation/inference/decision/gate contract")
    receipt_id = planned_receipt_id or new_receipt_id()
    if re.fullmatch(r"RCPT-[a-f0-9]{24}", receipt_id) is None:
        raise TransactionError("planned receipt identity is malformed")
    plan: dict[str, Any] = {
        "schema_version": PLAN_SCHEMA,
        "artifact_kind": "transaction_plan",
        "permission_grant": False,
        "operation": operation_name,
        "scope": scope,
        "created_at": utc_timestamp(),
        "planned_receipt_id": receipt_id,
        "source_evidence": evidence,
        "analysis": proposal_analysis,
        "assumptions": assumptions,
        "confidence": confidence,
        "limitations": limitations,
        "governing_instruction_fingerprint": instruction_fingerprint(root),
        "evidence_preimages": [
            path_state(root, path)
            for path in dict.fromkeys(evidence_paths or [])
        ],
        "targets": targets,
        "operations": operations,
        "conflicts": conflicts or [],
        "excluded_paths": excluded_paths or [],
        "validation": {
            "staged_argv": staged_argv,
            "declared_write_paths": derived_paths,
            "post_apply_argv": post_argv,
        },
        "rollback_plan": {
            "strategy": "receipt_embeds_exact_preimage",
            "refuse_if_post_apply_changed": True,
            "interruption_recovery": "write_ahead_pending_journal",
        },
    }
    plan["canonical_plan_digest"] = plan_digest(plan)
    return plan


def load_plan(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise TransactionError(f"cannot load transaction plan: {error}") from error
    if not isinstance(value, dict) or value.get("schema_version") != PLAN_SCHEMA:
        raise TransactionError("unsupported or malformed transaction plan")
    if value.get("permission_grant") is not False:
        raise TransactionError("transaction plan must be explicitly non-authorizing")
    expected = plan_digest(value)
    if value.get("canonical_plan_digest") != expected:
        raise TransactionError("transaction plan digest is invalid")
    return value


def write_new_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    data = json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n"
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError as error:
        raise TransactionError(f"refusing to overwrite existing artifact: {path}") from error
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())


def git_common_directory(root: Path) -> Path:
    """Resolve the current repository's Git common directory without mutating it."""
    result = subprocess.run(
        ["git", "rev-parse", "--git-common-dir"],
        cwd=root,
        capture_output=True,
        check=False,
        shell=False,
        env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
    )
    if result.returncode:
        raise TransactionError("work completion requires an initialized Git repository")
    raw = result.stdout.decode("utf-8", errors="strict").strip()
    if not raw or "\x00" in raw or "\n" in raw or "\r" in raw:
        raise TransactionError("Git common-directory observation is malformed")
    path = Path(raw)
    candidate = path if path.is_absolute() else root / path
    try:
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise TransactionError("Git common directory is unavailable") from error
    if not resolved.is_dir():
        raise TransactionError("Git common directory is not a directory")
    return resolved


def work_completion_receipt_directory(root: Path) -> Path:
    """Return the local, non-source progress store used by resumable external effects."""
    return git_common_directory(root) / "octon-mini" / "work-completion" / "receipts"


def work_completion_receipt_path(root: Path, receipt_id: str) -> Path:
    if re.fullmatch(r"WCR-[a-f0-9]{24}", receipt_id) is None:
        raise TransactionError("work-completion receipt identity is malformed")
    return work_completion_receipt_directory(root) / f"{receipt_id}.json"


def load_work_completion_receipt(root: Path, receipt_id: str) -> dict[str, Any]:
    path = work_completion_receipt_path(root, receipt_id)
    if path.is_symlink() or not path.is_file():
        raise TransactionError(f"work-completion receipt is unavailable: {receipt_id}")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise TransactionError(f"cannot load work-completion receipt: {error}") from error
    if not isinstance(value, dict) or value.get("receipt_id") != receipt_id:
        raise TransactionError("work-completion receipt envelope is invalid")
    return value


def write_work_completion_receipt(
    root: Path,
    receipt: dict[str, Any],
    *,
    create: bool,
) -> Path:
    """Durably create or replace one exact local external-progress receipt."""
    receipt_id = receipt.get("receipt_id")
    if not isinstance(receipt_id, str):
        raise TransactionError("work-completion receipt lacks an identity")
    path = work_completion_receipt_path(root, receipt_id)
    data = (json.dumps(receipt, indent=2, sort_keys=True, allow_nan=False) + "\n").encode("utf-8")
    if create:
        if path.exists() or path.is_symlink():
            raise TransactionError(f"work-completion receipt already exists: {receipt_id}")
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError as error:
            raise TransactionError(f"work-completion receipt already exists: {receipt_id}") from error
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        return path
    if path.is_symlink() or not path.is_file():
        raise TransactionError(f"work-completion receipt cannot be resumed: {receipt_id}")
    try:
        previous = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise TransactionError(f"cannot compare work-completion receipt: {error}") from error
    if not isinstance(previous, dict):
        raise TransactionError("existing work-completion receipt is malformed")
    for field in (
        "schema_version",
        "artifact_kind",
        "permission_grant",
        "receipt_id",
        "plan_digest",
        "plan",
        "started_at",
        "rollback",
        "resume",
        "readiness_claim",
        "limitations",
    ):
        if previous.get(field) != receipt.get(field):
            raise TransactionError(
                f"work-completion receipt immutable field changed: {field}"
            )
    for field in ("progress", "completed_operations", "authorization_history"):
        before = previous.get(field)
        after = receipt.get(field)
        if (
            not isinstance(before, list)
            or not isinstance(after, list)
            or after[: len(before)] != before
        ):
            raise TransactionError(
                f"work-completion receipt history is not append-only: {field}"
            )
    if previous.get("state") == "completed" and receipt != previous:
        raise TransactionError("completed work-completion receipts are immutable")
    _atomic_write(path, data, 0o600)
    return path


def list_work_completion_receipts(root: Path) -> list[Path]:
    directory = work_completion_receipt_directory(root)
    if not directory.exists():
        return []
    if directory.is_symlink() or not directory.is_dir():
        raise TransactionError("work-completion receipt store is unsafe")
    return [
        path
        for path in sorted(directory.glob("WCR-*.json"))
        if path.is_file() and not path.is_symlink()
    ]


def _decode_operations(plan: dict[str, Any]) -> dict[str, bytes | None]:
    decoded: dict[str, bytes | None] = {}
    for item in plan["operations"]:
        content = item["content_base64"]
        try:
            decoded[item["path"]] = base64.b64decode(content, validate=True) if content is not None else None
        except (ValueError, TypeError) as error:
            raise TransactionError(f"invalid operation payload for {item['path']}") from error
    return decoded


def _atomic_write(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb", prefix=f".{path.name}.octon-transaction-stage-", dir=path.parent, delete=False
        ) as handle:
            temporary = Path(handle.name)
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def _apply_static(root: Path, plan: dict[str, Any], decoded: dict[str, bytes | None]) -> None:
    for item in plan["operations"]:
        target = confined_path(root, item["path"])
        content = decoded[item["path"]]
        if item["action"] == "delete":
            target.unlink()
        else:
            assert content is not None
            _atomic_write(target, content, int(item["mode"]))


def _tree_state(root: Path) -> dict[str, tuple[str, int, str]]:
    values: dict[str, tuple[str, int, str]] = {}
    for path in sorted(root.rglob("*")):
        relative = path.relative_to(root).as_posix()
        if relative == ".git" or relative.startswith(".git/"):
            continue
        if relative == ".agent/transactions" or relative.startswith(".agent/transactions/"):
            continue
        metadata = path.lstat()
        mode = stat.S_IMODE(metadata.st_mode)
        if path.is_symlink():
            values[relative] = ("symlink", mode, sha256(os.readlink(path).encode("utf-8")))
        elif path.is_file():
            values[relative] = ("file", mode, sha256(path.read_bytes()))
        elif path.is_dir():
            values[relative] = ("directory", mode, "")
        else:
            values[relative] = ("other", mode, "")
    return values


def _allowed_change(relative: str, declared: list[str]) -> bool:
    return any(relative == item or relative.startswith(item.rstrip("/") + "/") for item in declared)


def _run_commands(
    root: Path,
    commands: list[list[str]],
    *,
    phase: str,
    declared_writes: list[str],
    active_pending: tuple[str, str] | None = None,
) -> list[dict[str, Any]]:
    before = _tree_state(root)
    results: list[dict[str, Any]] = []
    for argv in commands:
        environment = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
        if active_pending is not None:
            environment.update(
                {
                    "OCTON_MINI_ACTIVE_TRANSACTION_RECEIPT": active_pending[0],
                    "OCTON_MINI_ACTIVE_TRANSACTION_PLAN_DIGEST": active_pending[1],
                }
            )
        result = subprocess.run(
            argv,
            cwd=root,
            capture_output=True,
            check=False,
            shell=False,
            env=environment,
        )
        results.append(
            {
                "phase": phase,
                "argv": argv,
                "exit_code": result.returncode,
                "stdout_sha256": sha256(result.stdout),
                "stderr_sha256": sha256(result.stderr),
            }
        )
        if result.returncode:
            detail = result.stderr.decode("utf-8", errors="replace").strip()
            raise TransactionError(
                f"{phase} validation failed"
                + (f": {detail[:4000]}" if detail else "")
            )
    after = _tree_state(root)
    changed = sorted(
        relative for relative in set(before) | set(after) if before.get(relative) != after.get(relative)
    )
    unexpected = [item for item in changed if not _allowed_change(item, declared_writes)]
    if unexpected:
        raise TransactionError(
            f"{phase} validation wrote outside its declared paths: " + ", ".join(unexpected[:20])
        )
    return results


def _clone_for_staging(root: Path, destination: Path) -> None:
    def ignore(directory: str, names: list[str]) -> set[str]:
        relative = Path(directory).resolve().relative_to(root.resolve())
        omitted: set[str] = set()
        if relative == Path(".") and ".git" in names:
            omitted.add(".git")
        if relative == Path(".agent/transactions") and "pending" in names:
            omitted.add("pending")
        return omitted

    shutil.copytree(root, destination, symlinks=True, copy_function=shutil.copy2, ignore=ignore)


def _staged_result(
    root: Path,
    plan: dict[str, Any],
    decoded: dict[str, bytes | None],
) -> tuple[dict[str, tuple[bytes | None, int | None]], list[dict[str, Any]]]:
    with tempfile.TemporaryDirectory(prefix="octon-mini-transaction-") as temporary:
        stage = Path(temporary) / "project"
        _clone_for_staging(root, stage)
        _apply_static(stage, plan, decoded)
        validation = plan["validation"]
        declared = list(validation["declared_write_paths"])
        results = _run_commands(
            stage,
            validation["staged_argv"],
            phase="staged",
            declared_writes=declared,
            active_pending=(
                str(plan["planned_receipt_id"]),
                str(plan["canonical_plan_digest"]),
            ),
        )
        outcomes: dict[str, tuple[bytes | None, int | None]] = {}
        for relative in (item["path"] for item in plan["targets"]):
            state = path_state(stage, relative)
            if state["type"] == "absent":
                outcomes[relative] = (None, None)
            elif state["type"] == "file":
                outcomes[relative] = (
                    confined_path(stage, relative).read_bytes(),
                    int(state["mode"]),
                )
            else:
                raise TransactionError(
                    f"staged output is not a regular file: {relative} ({state['type']})"
                )
        return outcomes, results


def _planned_outcomes(
    plan: dict[str, Any],
    decoded: dict[str, bytes | None],
    staged: dict[str, tuple[bytes | None, int | None]],
) -> dict[str, tuple[bytes | None, int | None]]:
    target_paths = {item["path"] for item in plan["targets"]}
    if set(staged) != target_paths:
        raise TransactionError("planned postimages do not match the closed target set")
    for relative, content in decoded.items():
        if staged[relative][0] != content:
            raise TransactionError(
                f"staged static postimage differs from its planned bytes: {relative}"
            )
    return staged


def _planned_path_state(
    relative: str,
    content: bytes | None,
    mode: int | None,
) -> dict[str, Any]:
    if content is None:
        return {"path": relative, "type": "absent", "mode": None, "sha256": None}
    if mode is None:
        raise TransactionError(f"planned file postimage lacks a mode: {relative}")
    return {
        "path": relative,
        "type": "file",
        "mode": int(mode),
        "sha256": sha256(content),
    }


def _receipt_paths(
    root: Path,
    plan: dict[str, Any],
    outcomes: dict[str, tuple[bytes | None, int | None]],
) -> list[dict[str, Any]]:
    values: list[dict[str, Any]] = []
    for expected in plan["targets"]:
        before_content = None
        if expected["type"] == "file":
            before_content = base64.b64encode(
                confined_path(root, expected["path"]).read_bytes()
            ).decode("ascii")
        content, mode = outcomes[expected["path"]]
        values.append(
            {
                "path": expected["path"],
                "before": expected,
                "after": _planned_path_state(expected["path"], content, mode),
                "before_content_base64": before_content,
            }
        )
    return values


def _created_parent_directories(root: Path, paths: list[str]) -> list[str]:
    created: set[str] = set()
    for relative in paths:
        parent = confined_path(root, relative).parent
        while parent != root and not parent.exists():
            created.add(parent.relative_to(root).as_posix())
            parent = parent.parent
    return sorted(created, key=lambda item: (item.count("/"), item))


def _remove_empty_directories(root: Path, relatives: list[str]) -> None:
    for relative in sorted(relatives, key=lambda item: (item.count("/"), item), reverse=True):
        path = confined_path(root, relative)
        try:
            path.rmdir()
        except (FileNotFoundError, OSError):
            pass


def _restore(
    root: Path,
    receipt_paths: list[dict[str, Any]],
    created_directories: list[str] | None = None,
) -> None:
    for item in reversed(receipt_paths):
        target = confined_path(root, item["path"])
        before = item["before"]
        if before["type"] == "absent":
            target.unlink(missing_ok=True)
            continue
        content = base64.b64decode(item["before_content_base64"], validate=True)
        _atomic_write(target, content, int(before["mode"]))
    _remove_empty_directories(root, created_directories or [])


def _write_pending(
    root: Path,
    receipt_id: str,
    plan: dict[str, Any],
    receipt_paths: list[dict[str, Any]],
    created_directories: list[str],
) -> tuple[dict[str, Any], Path]:
    value = {
        "schema_version": PENDING_SCHEMA,
        "artifact_kind": "transaction_pending",
        "permission_grant": False,
        "receipt_id": receipt_id,
        "operation": plan["operation"],
        "plan_digest": plan["canonical_plan_digest"],
        "started_at": utc_timestamp(),
        "paths": receipt_paths,
        "created_directories": created_directories,
        "recovery_rule": "restore_only_when_each_path_matches_its_preimage_or_planned_postimage",
    }
    path = confined_path(
        root, f".agent/transactions/pending/{receipt_id}.json"
    )
    write_new_json(path, value)
    return value, path


def apply_plan(
    root: Path,
    plan: dict[str, Any],
    accepted_digest: str,
    *,
    validate_preview: ValidatePreview | None = None,
) -> tuple[dict[str, Any], Path]:
    root = root.resolve()
    pending_root = root / ".agent/transactions/pending"
    if pending_root.is_dir() and any(pending_root.iterdir()):
        raise TransactionError(
            "an interrupted transaction is pending; run explicit transaction recovery before applying another plan"
        )
    digest = plan_digest(plan)
    if plan.get("canonical_plan_digest") != digest or accepted_digest != digest:
        raise TransactionError("apply requires the exact reviewed canonical plan digest")
    if plan.get("conflicts"):
        raise TransactionError("plan has unresolved conflicts and cannot be applied")
    if instruction_fingerprint(root) != plan.get("governing_instruction_fingerprint"):
        raise TransactionError("governing instructions changed after planning; re-plan")
    for expected in plan.get("evidence_preimages", []):
        if path_state(root, expected["path"]) != expected:
            raise TransactionError(
                f"transaction source evidence changed after planning: {expected['path']}"
            )
    for expected in plan["targets"]:
        if path_state(root, expected["path"]) != expected:
            raise TransactionError(f"transaction target changed after planning: {expected['path']}")
    decoded = _decode_operations(plan)
    if validate_preview is not None:
        preview_errors = validate_preview(decoded)
        if preview_errors:
            raise TransactionError("operation preview validation failed: " + "; ".join(preview_errors))

    staged_outcomes, staged_results = _staged_result(root, plan, decoded)
    outcomes = _planned_outcomes(plan, decoded, staged_outcomes)
    receipt_paths = _receipt_paths(root, plan, outcomes)
    created_directories = _created_parent_directories(
        root, [item["path"] for item in receipt_paths]
    )
    receipt_id = str(plan["planned_receipt_id"])
    if (
        (root / ".agent/transactions/pending" / f"{receipt_id}.json").exists()
        or (root / ".agent/transactions/receipts" / f"{receipt_id}.json").exists()
    ):
        raise TransactionError(f"planned receipt identity already exists: {receipt_id}")
    pending, pending_path = _write_pending(
        root, receipt_id, plan, receipt_paths, created_directories
    )
    validation_results = list(staged_results)
    try:
        _apply_static(root, plan, decoded)
        for relative in plan["validation"]["declared_write_paths"]:
            content, mode = outcomes[relative]
            target = confined_path(root, relative)
            if content is None:
                target.unlink(missing_ok=True)
            else:
                assert mode is not None
                _atomic_write(target, content, mode)
        for item in receipt_paths:
            if path_state(root, item["path"]) != item["after"]:
                raise TransactionError(
                    f"live transaction result differs from its staged postimage: {item['path']}"
                )
        validation_results.extend(
            _run_commands(
                root,
                plan["validation"]["post_apply_argv"],
                phase="post_apply",
                declared_writes=[],
                active_pending=(receipt_id, digest),
            )
        )
    except BaseException:
        _restore(root, receipt_paths, created_directories)
        pending_path.unlink(missing_ok=True)
        _remove_empty_directories(
            root,
            [".agent/transactions/pending", ".agent/transactions"],
        )
        raise

    receipt = {
        "schema_version": RECEIPT_SCHEMA,
        "artifact_kind": "transaction_receipt",
        "permission_grant": False,
        "receipt_id": receipt_id,
        "operation": plan["operation"],
        "plan_digest": digest,
        "applied_at": utc_timestamp(),
        "status": "applied",
        "paths": receipt_paths,
        "created_directories": created_directories,
        "validation": validation_results,
        "rollback": {
            "available": True,
            "refuse_if_post_apply_changed": True,
            "command": [
                "python",
                "-B",
                ".agent/scripts/octon.py",
                "transaction",
                "rollback",
                "--receipt",
                f".agent/transactions/receipts/{receipt_id}.json",
            ],
        },
    }
    receipt_path = confined_path(
        root, f".agent/transactions/receipts/{receipt_id}.json"
    )
    try:
        write_new_json(receipt_path, receipt)
    except BaseException:
        _restore(root, receipt_paths, created_directories)
        raise
    pending_path.unlink(missing_ok=True)
    return receipt, receipt_path


def rollback(root: Path, receipt_path: Path) -> dict[str, Any]:
    receipt_path = existing_transaction_artifact(root, receipt_path, "receipts")
    try:
        receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise TransactionError(f"cannot load receipt: {error}") from error
    if (
        not isinstance(receipt, dict)
        or receipt.get("schema_version") != RECEIPT_SCHEMA
        or receipt.get("status") not in {"applied", "rollback_in_progress"}
        or receipt.get("permission_grant") is not False
    ):
        raise TransactionError("receipt is not an applied or resumable v2 transaction receipt")
    if receipt["status"] == "applied":
        for item in receipt["paths"]:
            if path_state(root, item["path"]) != item["after"]:
                raise TransactionError(
                    f"rollback refused because a post-apply path changed: {item['path']}"
                )
        receipt["status"] = "rollback_in_progress"
        _atomic_write(
            receipt_path,
            (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode("utf-8"),
            stat.S_IMODE(receipt_path.stat().st_mode),
        )
    else:
        for item in receipt["paths"]:
            current = path_state(root, item["path"])
            if current not in (item["before"], item["after"]):
                raise TransactionError(
                    f"rollback resume refused because a path changed independently: {item['path']}"
                )
    _restore(root, receipt["paths"], receipt.get("created_directories", []))
    receipt["status"] = "rolled_back"
    receipt["rollback"]["available"] = False
    _atomic_write(
        receipt_path,
        (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode("utf-8"),
        stat.S_IMODE(receipt_path.stat().st_mode),
    )
    return receipt


def recover_pending(root: Path, pending_path: Path) -> dict[str, Any]:
    pending_path = existing_transaction_artifact(root, pending_path, "pending")
    try:
        pending = json.loads(pending_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise TransactionError(f"cannot load pending transaction: {error}") from error
    if (
        not isinstance(pending, dict)
        or pending.get("schema_version") != PENDING_SCHEMA
        or pending.get("permission_grant") is not False
    ):
        raise TransactionError("pending artifact is not a recoverable v1 journal")
    recovery_path = confined_path(
        root,
        f".agent/transactions/recovered/{pending['receipt_id']}.json",
    )
    receipt_path = confined_path(
        root,
        f".agent/transactions/receipts/{pending['receipt_id']}.json",
    )
    if receipt_path.exists():
        if recovery_path.exists():
            raise TransactionError(
                "pending transaction has both receipt and recovery evidence; specialist reconciliation is required"
            )
        try:
            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise TransactionError(f"cannot load existing transaction receipt: {error}") from error
        if (
            not isinstance(receipt, dict)
            or receipt.get("schema_version") != RECEIPT_SCHEMA
            or receipt.get("permission_grant") is not False
            or receipt.get("receipt_id") != pending.get("receipt_id")
            or receipt.get("operation") != pending.get("operation")
            or receipt.get("plan_digest") != pending.get("plan_digest")
            or receipt.get("paths") != pending.get("paths")
            or receipt.get("created_directories") != pending.get("created_directories")
        ):
            raise TransactionError("existing receipt conflicts with the pending journal")
        if receipt.get("status") == "rollback_in_progress":
            raise TransactionError(
                "receipt rollback is interrupted; retry ./octon transaction rollback with the exact receipt"
            )
        expected_field = "after" if receipt.get("status") == "applied" else "before"
        if receipt.get("status") not in {"applied", "rolled_back"}:
            raise TransactionError("existing receipt has an unsupported terminal state")
        for item in pending.get("paths", []):
            if path_state(root, item["path"]) != item[expected_field]:
                raise TransactionError(
                    f"transaction finalization refused because a target differs from its receipted state: {item['path']}"
                )
        pending_path.unlink()
        return receipt
    if recovery_path.exists():
        try:
            existing = json.loads(recovery_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            raise TransactionError(f"cannot load existing recovery evidence: {error}") from error
        recovered_at = existing.get("recovered_at") if isinstance(existing, dict) else None
        expected = dict(pending)
        expected.update(
            schema_version=RECOVERY_SCHEMA,
            artifact_kind="transaction_recovery",
            status="recovered_to_preimage",
            recovered_at=recovered_at,
        )
        if not isinstance(recovered_at, str) or existing != expected:
            raise TransactionError("existing recovery evidence conflicts with the pending journal")
        for item in pending.get("paths", []):
            if path_state(root, item["path"]) != item["before"]:
                raise TransactionError(
                    f"recovery finalization refused because a target is not at its preimage: {item['path']}"
                )
        pending_path.unlink()
        return existing
    for item in pending.get("paths", []):
        current = path_state(root, item["path"])
        allowed = [item.get("before")]
        if item.get("after") is not None:
            allowed.append(item.get("after"))
        if current not in allowed:
            raise TransactionError(
                f"interruption recovery refused because a target changed independently: {item['path']}"
            )
    _restore(root, pending["paths"], pending.get("created_directories", []))
    recovery = dict(pending)
    recovery.update(
        schema_version=RECOVERY_SCHEMA,
        artifact_kind="transaction_recovery",
        status="recovered_to_preimage",
        recovered_at=utc_timestamp(),
    )
    write_new_json(recovery_path, recovery)
    pending_path.unlink()
    return recovery
